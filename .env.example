APP_TITLE="Films API"
APP_VERSION="0.0.1"
DEBUG=False

DB_URL=mysql+asyncmy://user:pass@dburl:3306/sakila
# Укажите имя базы в MONGO_URL: оно берется из path-части URL.
# Без имени базы, например mongodb://mongo:27017, приложение не сможет выбрать default database.
MONGO_URL=mongodb://mongo:27017/films_py
# Замените ichub на точное название своей учебной группы при необходимости.
SEARCH_QUERIES_COLLECTION=final_project_ichub_dmitriy_hellwig
SEARCH_STATISTICS_LIMIT=5

# OpenTelemetry zero-code instrumentation
OTEL_SERVICE_NAME=films-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
# Метрики пока не собираются; отключение убирает попытки отправки в trace-only Collector.
OTEL_METRICS_EXPORTER=none

# Grafana local development credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
